rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn()
        && request.auth.token.email == 'editpeakstudio@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function hasUser() { return signedIn() && exists(userPath(request.auth.uid)); }
    function profile() { return get(userPath(request.auth.uid)).data; }
    function activeAdmin() {
      return owner() || (hasUser()
        && profile().role in ['admin', 'master_admin']
        && profile().isSuspended != true);
    }
    function masterAdmin() {
      return owner() || (hasUser() && profile().role == 'master_admin'
        && profile().isSuspended != true);
    }
    function permitted(key) {
      return masterAdmin() || (activeAdmin()
        && profile().permissions is list
        && profile().permissions.hasAny([key]));
    }
    function canManageUsers() { return permitted('students.manage'); }
    function canManageAdmins() { return owner() || permitted('admins.manage'); }
    function canVerifyPayments() { return permitted('payments.verify'); }
    function canManageSettings() { return permitted('settings.manage'); }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function validCategory(id) {
      return request.resource.data.id == id
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.thumbnailUrl is string
        && request.resource.data.price is number
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is string;
    }
    function validFolder(id) {
      return request.resource.data.id == id
        && request.resource.data.name is string
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.order is number
        && request.resource.data.createdAt is string;
    }
    function validVideo(id) {
      return request.resource.data.id == id
        && request.resource.data.title is string
        && request.resource.data.categoryId is string
        && request.resource.data.videoUrl is string
        && request.resource.data.isPublished is bool
        && request.resource.data.isFreePreview is bool
        && request.resource.data.order is number
        && request.resource.data.createdAt is string;
    }
    function validPdf(id) {
      return request.resource.data.id == id
        && request.resource.data.title is string
        && request.resource.data.categoryId is string
        && request.resource.data.pdfUrl is string
        && request.resource.data.isPublished is bool
        && request.resource.data.order is number
        && request.resource.data.pageCount is number
        && request.resource.data.createdAt is string;
    }
    function ownsEntitlement(categoryId) {
      return signedIn() && exists(userPath(request.auth.uid))
        && (get(userPath(request.auth.uid)).data.hasAllAccess == true
          || (get(userPath(request.auth.uid)).data.allowedCategories is list
            && get(userPath(request.auth.uid)).data.allowedCategories.hasAny([categoryId])));
    }
    function canReadVideo() {
      return activeAdmin() || (signedIn() && resource.data.isPublished == true
        && (resource.data.isFreePreview == true || ownsEntitlement(resource.data.categoryId)));
    }
    function canReadPdf() {
      return activeAdmin() || (signedIn() && resource.data.isPublished == true
        && ownsEntitlement(resource.data.categoryId));
    }

    match /users/{uid} {
      allow get: if self(uid) || activeAdmin();
      allow list: if activeAdmin();
      allow create: if (owner() && uid == request.auth.uid)
        || (self(uid)
          && request.resource.data.role == 'user'
          && request.resource.data.permissions == []
          && request.resource.data.isPlatformOwner == false
          && request.resource.data.hasAllAccess == false
          && request.resource.data.isSuspended == false
          && request.resource.data.subscriptionStatus == 'none'
          && request.resource.data.allowedCategories is list
          && request.resource.data.allowedCategories.size() == 0
          && request.resource.data.email == (request.auth.token.email == null ? '' : request.auth.token.email)
          && request.resource.data.keys().hasOnly([
            'email','displayName','photoURL','phoneNumber','role','isPlatformOwner',
            'predefinedRole','assignedRoleTitle','permissions','isSuspended','hasAllAccess',
            'allowedCategories','allowedFolders','subscriptionStatus','accessExpiry','lastLogin','createdAt'
          ]));
      allow update: if (owner() && uid != request.auth.uid
          && resource.data.role != 'master_admin')
        || (canManageAdmins() && uid != request.auth.uid
          && resource.data.role != 'master_admin'
          && request.resource.data.role in ['user','admin']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role','predefinedRole','assignedRoleTitle','permissions','isSuspended'
          ])
          && request.resource.data.permissions is list
          && (masterAdmin() || request.resource.data.permissions.hasOnly(profile().permissions))
          && request.resource.data.permissions.hasOnly([
            'dashboard.view','analytics.view','folders.create','folders.edit','folders.delete',
            'videos.create','videos.edit','videos.delete','pdfs.create','pdfs.edit','pdfs.delete',
            'students.manage','payments.verify','settings.manage','admins.manage','audit.view'
          ]))
        || (owner() && uid != request.auth.uid && resource.data.role == 'master_admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role','predefinedRole','assignedRoleTitle','permissions','isSuspended','hasAllAccess','subscriptionStatus'
          ]))
        || ((canManageUsers() || canVerifyPayments()) && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hasAllAccess','allowedCategories','subscriptionStatus','accessExpiry'
        ]))
        || (self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','photoURL','phoneNumber','lastLogin'
        ])
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role)
        || (owner() && self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','photoURL','phoneNumber','lastLogin','isPlatformOwner'
        ])
          && request.resource.data.role == resource.data.role);
      allow delete: if owner() && uid != request.auth.uid;
    }

    match /categories/{id} {
      allow read: if signedIn();
      allow create: if permitted('folders.create') && validCategory(id);
      allow update: if permitted('folders.edit') && validCategory(id);
      allow delete: if permitted('folders.delete');
    }
    match /folders/{id} {
      allow read: if signedIn();
      allow create: if permitted('folders.create') && validFolder(id);
      allow update: if permitted('folders.edit') && validFolder(id);
      allow delete: if permitted('folders.delete');
    }
    match /videos/{id} {
      allow read: if canReadVideo();
      allow create: if permitted('videos.create') && validVideo(id);
      allow update: if permitted('videos.edit') && validVideo(id);
      allow delete: if permitted('videos.delete');
    }
    match /pdfs/{id} {
      allow read: if canReadPdf();
      allow create: if permitted('pdfs.create') && validPdf(id);
      allow update: if permitted('pdfs.edit') && validPdf(id);
      allow delete: if permitted('pdfs.delete');
    }

    match /paymentRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.status == 'pending'
        && request.resource.data.planType in ['all_access','category']
        && (request.resource.data.planType != 'category' || request.resource.data.categoryId is string)
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.utr is string && request.resource.data.utr.size() > 0
        && request.resource.data.proofUrl is string
        && request.resource.data.proofUrl.size() <= 900000
        && request.resource.data.userEmail == (request.auth.token.email == null ? '' : request.auth.token.email)
        && request.resource.data.keys().hasOnly([
          'id','uid','userEmail','userName','planType','categoryId','categoryName',
          'amount','utr','proofUrl','status','submittedAt'
        ]);
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || canVerifyPayments());
      allow update: if canVerifyPayments() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.resolvedBy == (request.auth.token.email == null ? '' : request.auth.token.email)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','adminNote','resolvedAt','resolvedBy'
        ]);
      allow delete: if owner();
    }
    match /payment_requests/{id} { allow read, write: if false; }
    match /settings/{id} {
      allow read: if signedIn();
      allow create, update: if canManageSettings();
      allow delete: if owner();
    }
    match /sales_analytics/{id} {
      allow read: if permitted('analytics.view');
      allow create: if canVerifyPayments();
      allow update, delete: if owner();
    }
    match /audit_logs/{id} {
      allow read: if permitted('audit.view');
      allow create: if activeAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.timestamp is string;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
